{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegCheck KVKK md. 10 compliance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "controller",
    "overall_assessment",
    "summary",
    "element_checks",
    "findings",
    "penalty_exposure",
    "human_review_required",
    "sources_consulted"
  ],
  "properties": {
    "document_id": {
      "type": "string"
    },
    "controller": {
      "type": "string",
      "description": "Veri sorumlusunun unvanı (belgede yazdığı gibi); yoksa \"belirtilmemiş\""
    },
    "overall_assessment": {
      "type": "string",
      "enum": [
        "compliant",
        "non_compliant",
        "needs_human_review"
      ]
    },
    "summary": {
      "type": "string",
      "description": "En fazla 3 cümlelik Türkçe özet"
    },
    "element_checks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "element",
          "status",
          "evidence"
        ],
        "properties": {
          "element": {
            "type": "string",
            "enum": [
              "10/1-a",
              "10/1-b",
              "10/1-c",
              "10/1-ç",
              "10/1-d"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "present",
              "deficient",
              "missing"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "Belgeden kısa alıntı; eksikse boş string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "element",
          "issue_type",
          "severity",
          "title",
          "description",
          "document_excerpt",
          "citations",
          "confidence",
          "escalate",
          "escalation_reason",
          "recommendation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "element": {
            "type": "string",
            "enum": [
              "10/1-a",
              "10/1-b",
              "10/1-c",
              "10/1-ç",
              "10/1-d",
              "T5/1-f",
              "T5/1-g",
              "T5/1-ğ",
              "T5/1-h",
              "T5/1-ı",
              "T5/1-i",
              "T5/1-j",
              "other"
            ]
          },
          "issue_type": {
            "type": "string",
            "enum": [
              "missing",
              "deficient",
              "vague",
              "other"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "document_excerpt": {
            "type": "string",
            "description": "İlgili belge metni; unsur tamamen eksikse boş string"
          },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "reference",
                "source_url",
                "supporting_quote",
                "retrieved_via"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "kanun",
                    "kurul_karari"
                  ]
                },
                "reference": {
                  "type": "string",
                  "description": "Örn. \"6698 md. 10/1-ç\" veya \"Kurul Kararı 2021/85\""
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "supporting_quote": {
                  "type": "string",
                  "description": "Kaynaktan kelimesi kelimesine kısa alıntı (araç çıktısında veya sistem talimatında geçen)"
                },
                "retrieved_via": {
                  "type": "string",
                  "enum": [
                    "system_prompt",
                    "search_within_kanun",
                    "get_kvkk_document_markdown"
                  ]
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "escalate": {
            "type": "boolean"
          },
          "escalation_reason": {
            "type": "string",
            "description": "escalate=true ise neden insan incelemesi gerektiği; değilse boş string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      }
    },
    "penalty_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicable",
        "reference",
        "range",
        "source_url",
        "note"
      ],
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "reference": {
          "type": "string"
        },
        "range": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "human_review_required": {
      "type": "boolean",
      "description": "true if any finding has escalate=true. The Maestro exclusive gateway routes on this field."
    },
    "sources_consulted": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "input",
          "used_in_findings"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "used_in_findings": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
